# Server
PORT=3000
HOST=0.0.0.0

# Neon Postgres (ejemplo)
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# Local Docker (compose mapea 5434→5432):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5434/dojapp

# JWT (genera uno largo en producción)
JWT_SECRET=cambiar-en-produccion-minimo-32-caracteres
# JWT_ACCESS_EXPIRES=2h
# JWT_REFRESH_EXPIRES=30d

# CORS: incluye Capacitor + web si la usas
# CORS_ORIGIN=https://localhost,capacitor://localhost,http://localhost

# Detrás de Railway / reverse proxy HTTPS
TRUST_PROXY=true

# Opcional: ejecutar seed en el primer deploy (solo una vez)
# RUN_SEED=true
# En producción el entrypoint también exige:
# ALLOW_PROD_SEED=true
# (el seed resetea contraseñas demo — no dejarlo permanente)
