# Frontend (Vite) - desarrollo web
VITE_API_URL=http://localhost:3000

# Android emulator (host machine from emulator network)
# VITE_API_URL_ANDROID=http://10.0.2.2:3000

# Android physical device on same WiFi as your PC
# VITE_API_URL_ANDROID=http://192.168.x.x:3000

# Production HTTPS API (used by release builds)
VITE_API_URL_PRODUCTION=https://api.tudominio.com
